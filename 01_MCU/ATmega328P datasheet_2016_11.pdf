        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Microchip, AtmelÂ® picoPowerÂ® ATmega328/P, low-power CMOS 8-bit microcontroller based on the AVRÂ® enhanced RISC architecture.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">ATmega328/P</rdf:li>
        </rdf:Alt>
      </dc:title>
